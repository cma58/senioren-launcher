# API-sleutels voor Stap 2 (AI & spraak). Kopieer dit bestand naar ".env"
# en vul je eigen sleutels in. Vite leest alleen variabelen met prefix VITE_.
# LET OP: sleutels in de frontend zijn zichtbaar voor de gebruiker. Voor
# productie horen deze achter een kleine proxy/serverless-functie te staan.

# Google Gemini (gratis tier) — grammatica- en antwoordcontrole
VITE_GEMINI_API_KEY=

# Groq (Whisper large-v3) — spraak-naar-tekst
VITE_GROQ_API_KEY=
