# API-sleutels voor de spreekoefening (AI & spraak).
#
# LET OP: je hebt dit bestand NIET per se nodig! Je kunt de sleutels ook
# gewoon in de app invullen via het tandwiel (⚙️) rechtsboven — dat is het
# makkelijkst op de telefoon en vereist geen herstart.
#
# Wil je ze toch hier zetten: kopieer dit bestand naar ".env" en vul in.
# Vite leest alleen variabelen met de prefix VITE_.
# (Sleutels in de frontend zijn zichtbaar voor de gebruiker — prima voor
#  privégebruik op je eigen toestel, maar zet de app zo niet openbaar online.)

# Google Gemini (gratis tier) — grammatica- en antwoordcontrole
VITE_GEMINI_API_KEY=

# Groq (Whisper large-v3) — spraak-naar-tekst
VITE_GROQ_API_KEY=

# Optioneel: andere modelnamen gebruiken (standaardwaarden hieronder)
# VITE_GEMINI_MODEL=gemini-2.0-flash
# VITE_GROQ_MODEL=whisper-large-v3
